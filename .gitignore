# --- Python ---
__pycache__/
*.py[cod]
.venv/

# --- Unity: uretilen klasorler ---
# Kaliplar bilerek ON EKSIZ: '/' ile bitiyorlar ve herhangi bir derinlikte
# eslesiyorlar. Onceden 'unity/Library/' yazilmisti ve sadece o tam konumu
# yakaliyordu; proje baska bir seviyeye tasindiginda isikladi.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# --- IDE / editor ---
# .vs icindeki .vsidx dosyalari Visual Studio acikken KILITLI olur; git
# acamayinca butun 'add' islemi coker. O yuzden mutlaka yok sayilmali.
.vs/
.vscode/
.idea/
.consulo/
*.csproj
*.sln
*.unityproj
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# --- cikti / paket ---
*.apk
*.aab
*.unitypackage
*.app

# --- cokme raporlari ---
sysinfo.txt
*.stackdump
crashlytics-build.properties

# --- Unity'nin urettigi ama gereksiz meta'lar ---
/[Aa]ssets/[Aa]sset[Ss]tore[Tt]ools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*
